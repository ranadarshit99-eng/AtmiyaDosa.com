    { "key": "discount", "type": "float", "required": false },
    { "key": "total_amount", "type": "float", "required": true },
    { "key": "status", "type": "string", "required": true, "size": 32 },
    { "key": "tab_type", "type": "string", "required": true, "size": 32 },
    { "key": "time", "type": "string", "required": true, "size": 32 },
    { "key": "payment_mode", "type": "string", "required": false, "size": 32 },
    { "key": "special_note", "type": "string", "required": false, "size": 256 }
  ]
